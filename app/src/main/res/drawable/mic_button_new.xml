<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Circular gradient background -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#22b8e0"
                android:centerColor="#7b4dff"
                android:endColor="#c026d3" />
        </shape>
    </item>

    <!-- Optional: Add shadow/elevation effect -->
    <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#22b8e0"
                android:centerColor="#7b4dff"
                android:endColor="#c026d3" />
            <stroke android:width="1dp" android:color="#000000" android:dashWidth="0dp" />
        </shape>
    </item>
</layer-list>
